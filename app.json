{
  "expo": {
    "name": "Aloro",
    "slug": "aloro",
    "scheme": "aloro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aloro.app"
    },
    "android": {
      "package": "com.aloro.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#312E81",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Aloro uses the microphone so you can practice speaking.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidSdk": "classic",
          "androidAppId": "ca-app-pub-7985253532835776~5037725674",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd21eece-75da-4f4c-bff3-2864466a24cd"
      }
    },
    "owner": "shamouka"
  }
}
