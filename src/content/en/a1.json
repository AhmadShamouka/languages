            { "id": "shopping-2-4", "kind": "sentence", "text": "It's too big.", "gloss": { "de": "Es ist zu groß.", "fr": "C'est trop grand." }, "prompt": { "de": "Sag, dass es zu groß ist", "fr": "Dis que c'est trop grand" } },
            { "id": "shopping-2-5", "kind": "sentence", "text": "Do you have a smaller size?", "gloss": { "de": "Haben Sie eine kleinere Größe?", "fr": "Vous avez une taille plus petite ?" }, "prompt": { "de": "Frag nach einer kleineren Größe", "fr": "Demande une taille plus petite" } }
          ],
          "rolePlay": {
            "topic": "Trying on clothes in a clothing shop",
            "goal": { "de": "Frag, ob du etwas anprobieren kannst, sag, wie es passt, und frag nach einer anderen Größe.", "fr": "Demande à essayer un vêtement, dis comment il te va et demande une autre taille." },
            "opening": "Hi! Can I help you?",
            "starterLines": ["Can I try this on?", "Do you have a smaller size?"]
          }
        }
      ]
    },
    {
      "id": "routine",
      "title": { "de": "Der Alltag", "fr": "La vie quotidienne" },
      "lessons": [
        {
          "id": "routine-1",
          "title": { "de": "Mein Tag", "fr": "Ma journée" },
          "items": [
            { "id": "routine-1-1", "kind": "word", "text": "morning", "gloss": { "de": "der Morgen", "fr": "le matin" }, "prompt": { "de": "Sag das Wort für Morgen", "fr": "Dis le mot pour matin" } },
            { "id": "routine-1-2", "kind": "word", "text": "evening", "gloss": { "de": "der Abend", "fr": "le soir" }, "prompt": { "de": "Sag das Wort für Abend", "fr": "Dis le mot pour soir" } },
            { "id": "routine-1-3", "kind": "sentence", "text": "I get up at seven o'clock.", "gloss": { "de": "Ich stehe um sieben Uhr auf.", "fr": "Je me lève à sept heures." }, "prompt": { "de": "Sag, dass du um 7:00 Uhr aufstehst", "fr": "Dis que tu te lèves à 7 h 00" } },
            { "id": "routine-1-4", "kind": "sentence", "text": "I have breakfast at home.", "gloss": { "de": "Ich frühstücke zu Hause.", "fr": "Je prends le petit-déjeuner à la maison." }, "prompt": { "de": "Sag, dass du zu Hause frühstückst", "fr": "Dis que tu prends le petit-déjeuner à la maison" } },
            { "id": "routine-1-5", "kind": "sentence", "text": "I go to work by bus.", "gloss": { "de": "Ich fahre mit dem Bus zur Arbeit.", "fr": "Je vais au travail en bus." }, "prompt": { "de": "Sag, dass du mit dem Bus zur Arbeit fährst", "fr": "Dis que tu vas au travail en bus" } }
          ],
          "rolePlay": {
            "topic": "Telling a new colleague about your daily routine",
            "goal": { "de": "Erzähl, wann du aufstehst und wie du zur Arbeit kommst, und frag nach dem Tag deines Gegenübers.", "fr": "Raconte quand tu te lèves et comment tu vas au travail, puis pose des questions sur sa journée." },
            "opening": "What time do you usually get up?",
            "starterLines": ["I get up at seven o'clock.", "I go to work by bus."]
          }
        },
        {
          "id": "routine-2",
          "title": { "de": "Freizeit", "fr": "Les loisirs" },
          "items": [
            { "id": "routine-2-1", "kind": "word", "text": "music", "gloss": { "de": "die Musik", "fr": "la musique" }, "prompt": { "de": "Sag das Wort für Musik", "fr": "Dis le mot pour musique" } },
            { "id": "routine-2-2", "kind": "word", "text": "sport", "gloss": { "de": "der Sport", "fr": "le sport" }, "prompt": { "de": "Sag das Wort für Sport", "fr": "Dis le mot pour sport" } },
            { "id": "routine-2-3", "kind": "sentence", "text": "I like reading.", "gloss": { "de": "Ich lese gern.", "fr": "J'aime lire." }, "prompt": { "de": "Sag, dass du gern liest", "fr": "Dis que tu aimes lire" } },
            { "id": "routine-2-4", "kind": "sentence", "text": "At the weekend I play football.", "gloss": { "de": "Am Wochenende spiele ich Fußball.", "fr": "Le week-end, je joue au foot." }, "prompt": { "de": "Sag, dass du am Wochenende Fußball spielst", "fr": "Dis que tu joues au foot le week-end" } },
            { "id": "routine-2-5", "kind": "sentence", "text": "What do you do in your free time?", "gloss": { "de": "Was machst du in deiner Freizeit?", "fr": "Qu'est-ce que tu fais pendant ton temps libre ?" }, "prompt": { "de": "Frag nach den Hobbys", "fr": "Demande quels sont ses loisirs" } }
          ],
          "rolePlay": {
            "topic": "Chatting about hobbies with a new friend",
            "goal": { "de": "Erzähl, was du gern machst, und frag, was die andere Person in der Freizeit macht.", "fr": "Dis ce que tu aimes faire et demande ce qu'il fait pendant son temps libre." },
            "opening": "What do you like doing at the weekend?",
            "starterLines": ["I like reading.", "And you? What do you do in your free time?"]
          }
        }
      ]
    }
  ]
