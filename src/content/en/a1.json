            { "id": "shopping-2-2", "kind": "word", "text": "shoes", "gloss": { "de": "die Schuhe", "fr": "les chaussures" }, "prompt": { "de": "Sag das Wort für Schuhe", "fr": "Dis le mot pour chaussures" } },
